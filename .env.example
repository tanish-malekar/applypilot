# Zero-cost, no-key baseline:
CONTENT_MODE=deterministic
JOB_AGENTS_DATA_DIR=runtime
JOB_AGENTS_BASE_URL=http://127.0.0.1:8000
# Optional hosted AI mode: use a Groq FREE-plan account (do not enable billing).
# CONTENT_MODE=groq
# GROQ_API_KEY=configure-in-hosting-secret-settings
GROQ_MODEL=openai/gpt-oss-20b
# Optional local open-model mode, served by Ollama on your computer:
# CONTENT_MODE=ollama
# OLLAMA_MODEL=your-installed-model

# Managed user accounts and durable storage (configure together in hosting settings):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key
# DATABASE_URL=your-private-PostgreSQL-session-pooler-URI-with-sslmode=require
# AUTH_REQUIRED=1
# Never put a Supabase secret/service-role key into SUPABASE_PUBLISHABLE_KEY.
